{
  "tests": [
    {
      "name": "Appointments list without token is rejected",
      "method": "GET",
      "path": "/?doctor_id=1",
      "expectedStatus": 401,
      "expectedBody": {},
      "bodyMatcher": "partial"
    },
    {
      "name": "Check available slots",
      "method": "GET",
      "path": "/?action=available-slots&doctor_id=1&date=2025-03-01",
      "expectedStatus": 200,
      "expectedBody": {},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get doctor logs (without token is rejected)",
      "method": "GET",
      "path": "/?action=logs&limit=10",
      "expectedStatus": 401,
      "expectedBody": {},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get doctor logs by doctor_id (without token is rejected)",
      "method": "GET",
      "path": "/?action=logs&doctor_id=7&limit=5",
      "expectedStatus": 401,
      "expectedBody": {},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get my appointments by phone",
      "method": "GET",
      "path": "/?action=my-appointments&phone=79001234567",
      "expectedStatus": 200,
      "expectedBody": {},
      "bodyMatcher": "partial"
    },
    {
      "name": "Appointment delete without token is rejected",
      "method": "DELETE",
      "path": "/?id=999999",
      "expectedStatus": 401,
      "expectedBody": {},
      "bodyMatcher": "partial"
    },
    {
      "name": "Appointment update without token is rejected",
      "method": "PUT",
      "path": "/",
      "body": {
        "id": 999999,
        "status": "cancelled"
      },
      "expectedStatus": 401,
      "expectedBody": {},
      "bodyMatcher": "partial"
    }
  ]
